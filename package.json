{
  "name": "nocetta",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Anchored, bitemporal, DAG memory system for coding agents (spike).",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/facade/index.d.ts",
      "default": "./dist/facade/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./retrieval": {
      "types": "./dist/retrieval/index.d.ts",
      "default": "./dist/retrieval/index.js"
    },
    "./supersede": {
      "types": "./dist/supersede/index.d.ts",
      "default": "./dist/supersede/index.js"
    },
    "./bitemporal": {
      "types": "./dist/bitemporal/index.d.ts",
      "default": "./dist/bitemporal/index.js"
    },
    "./drift": {
      "types": "./dist/drift/index.d.ts",
      "default": "./dist/drift/index.js"
    },
    "./anchor": {
      "types": "./dist/anchor/index.d.ts",
      "default": "./dist/anchor/index.js"
    },
    "./lore": {
      "types": "./dist/lore/index.d.ts",
      "default": "./dist/lore/index.js"
    },
    "./safety": {
      "types": "./dist/safety/index.d.ts",
      "default": "./dist/safety/index.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "default": "./dist/capture/index.js"
    },
    "./repair": {
      "types": "./dist/repair/index.d.ts",
      "default": "./dist/repair/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
